# Copy this file to .env for local runs. Never commit real API keys.
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1/chat/completions

# Used by LLM-as-judge scripts. The base should be a chat/completions endpoint.
OPENAI_API_KEY=your_openai_key
OPENAI_API_BASE=https://api.openai.com/v1/chat/completions

# Optional override used by some ad-hoc experiments.
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
